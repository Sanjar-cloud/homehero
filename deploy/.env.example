# Documentation only. No real credentials. Never copy the development .env here.
# Fill these in a private deploy/.env file only during the approved runtime phase.
# Public frontend build values (never Docker service names; no trailing slash):
# Local check: PUBLIC_ORIGIN=http://127.0.0.1:8080
#              PUBLIC_WS_URL=ws://127.0.0.1:8080/ws
# Final TLS:   PUBLIC_ORIGIN=https://<VPS_PUBLIC_IP>
#              PUBLIC_WS_URL=wss://<VPS_PUBLIC_IP>/ws
PUBLIC_ORIGIN=
PUBLIC_WS_URL=

# Approved portfolio database URI and a new random JWT secret, server-side only.
# Use single-quoted values if they contain $ or #. Do not paste secrets in chat.
MONGO_PROD=
SECRET_TOKEN=

# Safe bootstrap binding. Public HTTPS exposure is a separate checkpoint.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Use a new immutable tag per release; keep the previous images for rollback.
RELEASE_TAG=local
